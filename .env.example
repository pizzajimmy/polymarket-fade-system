# Copy to .env and fill in. All optional except where noted.

# ── Durable storage (IMPORTANT) ────────────────────────────────────────────────
# Point this at a REAL disk. On a VPS use /var/lib/pmfade. The whole reason for
# the rewrite was ephemeral storage losing the DB — don't put it on a tmpfs.
PMFADE_DB=/var/lib/pmfade/pmfade.db

# ── Dead-man heartbeat (strongly recommended) ──────────────────────────────────
# Create a free check at https://healthchecks.io and paste its ping URL.
# The collector pings it every cycle; you get alerted within minutes if it stalls.
HEALTHCHECK_URL=

# ── Telegram (optional — live push for high-score signals) ─────────────────────
TG_TOKEN=
TG_CHAT_ID=

# ── Tuning (optional; full list in pmfade/config.py) ───────────────────────────
POLL_INTERVAL_SECS=1800
NOTIFY_MIN_SCORE=80
RETAIN_BUFFER_DAYS=10
