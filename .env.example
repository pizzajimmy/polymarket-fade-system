# Copy to .env and fill in. All optional except where noted.

# ── Durable storage (IMPORTANT) ────────────────────────────────────────────────
# Point this at a REAL disk. On a VPS use /var/lib/pmfade. The whole reason for
# the rewrite was ephemeral storage losing the DB — don't put it on a tmpfs.
PMFADE_DB=/var/lib/pmfade/pmfade.db

# ── Dead-man heartbeat (strongly recommended) ──────────────────────────────────
# Create a free check at https://healthchecks.io and paste its ping URL.
# The collector pings it every cycle; you get alerted within minutes if it stalls.
HEALTHCHECK_URL=

# ── Telegram (REQUIRED for any live alerts — without it signals are logged
#    silently; check `journalctl -u pmfade | grep -i telegram` if unsure) ───────
TG_TOKEN=
TG_CHAT_ID=

# ── News qualification (Module E v2.1) ─────────────────────────────────────────
# Headlines: free Google News RSS, on by default. Set NEWS_FEED=none to disable.
NEWS_FEED=google_rss
# Input-change classifier: set a key to enable (console.anthropic.com; a few
# Haiku calls/day, fractions of a cent). Without it, fades stay operator-judged
# with headlines attached.
ANTHROPIC_API_KEY=

# ── Strategy toggles — apply calibration verdicts here ─────────────────────────
# e.g. disable a strategy whose CI is significantly negative:
# STRATEGIES_DISABLED=correlated_lag
STRATEGIES_DISABLED=

# ── Alerting ───────────────────────────────────────────────────────────────────
# Only push signals scoring >= this (others are logged silently):
NOTIFY_MIN_SCORE=80
# Restrict Telegram to these strategies (comma-separated). Empty = all.
# To alert ONLY on the operator-review fades, set this to news_fade_v2 (and,
# since only it can alert, drop NOTIFY_MIN_SCORE to see every one — its
# fallback-basis fades score ~70 and the auto-suppress path already handles
# the rest).
NOTIFY_STRATEGIES=

# ── Tuning (optional; full list in pmfade/config.py) ───────────────────────────
POLL_INTERVAL_SECS=1800
NOTIFY_MIN_SCORE=80
RETAIN_BUFFER_DAYS=10
