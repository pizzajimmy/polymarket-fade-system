# systemd unit for the pmfade collector.
# Install:
#   sudo cp deploy/pmfade.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now pmfade
#   journalctl -u pmfade -f
#
# Restart=always + the healthcheck heartbeat are the two things that fix
# "it went offline for ages without me noticing".

[Unit]
Description=Polymarket fade strategy-portfolio collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pmfade
WorkingDirectory=/opt/pmfade
# DB path set here directly so a missing/blank .env can never misplace the
# database or lose the durable path.
Environment=PMFADE_DB=/var/lib/pmfade/pmfade.db
# Leading '-' makes the env file OPTIONAL: a missing .env must not hard-fail the
# service (run_portfolio.py loads .env on its own too, so this is belt-and-braces).
EnvironmentFile=-/opt/pmfade/.env
ExecStart=/opt/pmfade/venv/bin/python run_portfolio.py loop
Restart=always
RestartSec=30
# Harden a little
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
